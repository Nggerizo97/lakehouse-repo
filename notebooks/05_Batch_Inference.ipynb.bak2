   },
   "outputs": [],
   "source": [
    "print(\"⚙️ Generando rentabilidad...\")\n",
    "df_scored_pandas = score_dataframe(df_pandas, bundle)\n",
    "print(\"✅ Inferencia completada.\")\n",
    "display(df_scored_pandas[[\"titulo\", \"city_token\", \"precio_num\", \"precio_predicho\", \"rentabilidad_potencial\", \"estado_inversion\"]].head(10))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
